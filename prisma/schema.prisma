generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int        @id @default(autoincrement()) @map("id")
  name             String     @map("name")
  image            String?    @map("image")
  email            String     @unique @map("email")
  password         String     @map("password")
  role             UserRole   @default(author) @map("role")
  position         String?    @map("position")
  status           UserStatus @default(active) @map("status")
  createdAt        DateTime   @default(now()) @map("created_at")
  approvedArticles Article[]  @relation("ArticleApprover")
  articles         Article[]  @relation("ArticleAuthor")

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement()) @map("id")
  name     String    @map("name")
  slug     String    @unique @map("slug")
  nameCn   String?   @map("name_cn")
  nameEn     String?   @map("name_en")
  icon       String?   @map("icon")
  articles   Article[]

  @@map("categories")
}

model Article {
  id                 Int           @id @default(autoincrement()) @map("id")
  categoryId         Int           @map("category_id")
  authorId           Int?          @map("author_id")
  slug               String        @unique @map("slug")
  status             ArticleStatus @default(draft)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  authorType         AuthorType    @default(user) @map("author_type")
  rejectReason       String?       @map("reject_reason")
  approvedAt         DateTime?     @map("approved_at")
  approvedById       Int?          @map("approved_by_id")
  viewCount          Int           @default(0) @map("view_count")
  shareCount         Int           @default(0) @map("share_count")
  compilerName       String?       @map("compiler_name")
  compilerPosition   String?       @map("compiler_position")
  isCompiled         Boolean       @default(false) @map("is_compiled")
  ownerName          String?       @map("owner_name")
  ownerPosition      String?       @map("owner_position")
  titleTh            String?       @map("title_th")
  titleEn            String?       @map("title_en")
  titleCn            String?       @map("title_cn")
  excerptTh          String?       @map("excerpt_th")
  excerptEn          String?       @map("excerpt_en")
  excerptCn          String?       @map("excerpt_cn")
  contentTh          String?       @map("content_th")
  contentEn          String?       @map("content_en")
  contentCn          String?       @map("content_cn")
  thumbnailTh        String?       @map("thumbnail_th")
  thumbnailEn        String?       @map("thumbnail_en")
  thumbnailCn        String?       @map("thumbnail_cn")
  penNameTh          String?       @map("pen_name_th")
  penNameEn          String?       @map("pen_name_en")
  penNameCn          String?       @map("pen_name_cn")
  keywordsTh         String?       @map("keywords_th")
  keywordsEn         String?       @map("keywords_en")
  keywordsCn         String?       @map("keywords_cn")
  positionTh         String?       @map("position_th")
  positionEn         String?       @map("position_en")
  positionCn         String?       @map("position_cn")
  ownerNameTh        String?       @map("owner_name_th")
  ownerNameEn        String?       @map("owner_name_en")
  ownerNameCn        String?       @map("owner_name_cn")
  ownerPositionTh    String?       @map("owner_position_th")
  ownerPositionEn    String?       @map("owner_position_en")
  ownerPositionCn    String?       @map("owner_position_cn")
  compilerNameTh     String?       @map("compiler_name_th")
  compilerNameEn     String?       @map("compiler_name_en")
  compilerNameCn     String?       @map("compiler_name_cn")
  compilerPositionTh String?       @map("compiler_position_th")
  compilerPositionEn String?       @map("compiler_position_en")
  compilerPositionCn String?       @map("compiler_position_cn")
  title              String?
  excerpt            String?
  content            String?
  thumbnail          String?
  keywords           String?
  position           String?       @map("position")
  penName            String?       @map("pen_name")
  publishedAt        DateTime?     @map("published_at")
  rejectedAt         DateTime?     @map("rejected_at")
  tags               ArticleTag[]
  approvedBy         User?         @relation("ArticleApprover", fields: [approvedById], references: [id])
  author             User?         @relation("ArticleAuthor", fields: [authorId], references: [id])
  category           Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("articles")
}

model Tag {
  id       Int          @id @default(autoincrement()) @map("id")
  name     String       @unique @map("name")
  articles ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId Int     @map("article_id")
  tagId     Int     @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Comment {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name")
  email     String?  @map("email")
  message   String   @map("message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model SiteSetting {
  id            Int          @id @default(1)
  logo          String?
  phone         String?
  email         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  addressCn     String?      @map("address_cn")
  addressEn     String?      @map("address_en")
  addressTh     String?      @map("address_th")
  googleMapLink String?      @map("google_map_link")
  officeHoursCn String?      @map("office_hours_cn")
  officeHoursEn String?      @map("office_hours_en")
  officeHoursTh String?      @map("office_hours_th")
  nameCn        String?      @map("name_cn")
  nameEn        String?      @map("name_en")
  nameTh        String?      @map("name_th")
  socialLinks   SocialLink[]

  @@map("site_settings")
}

model SocialLink {
  id        Int         @id @default(autoincrement())
  platform  String
  url       String
  icon      String?
  order     Int         @default(0)
  siteId    Int         @default(1) @map("site_id")
  createdAt DateTime    @default(now()) @map("created_at")
  site      SiteSetting @relation(fields: [siteId], references: [id])

  @@map("social_links")
}

model ShortClip {
  id           Int      @id @default(autoincrement())
  titleTh      String   @map("title_th")
  titleEn      String   @map("title_en")
  titleCn      String   @map("title_cn")
  videoUrl     String?  @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  youtubeUrl   String?  @map("youtube_url")
  youtubeId    String?  @map("youtube_id")
  viewCount    Int      @default(0) @map("view_count")
  order        Int      @default(1) @map("order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("short_clips")
}

model SsruAround {
  id        Int      @id @default(autoincrement())
  titleTh   String   @map("title_th")
  titleEn   String?  @map("title_en")
  titleCn   String?  @map("title_cn")
  title     String?  @map("title")
  issue     String?  @map("issue")
  year      String?  @map("year")
  imageTh   String?  @map("image_th")
  imageEn   String?  @map("image_en")
  imageCn   String?  @map("image_cn")
  image     String?  @map("image")
  link      String?  @map("link")
  type      String?  @map("type")
  order     Int      @default(1) @map("order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ssru_around")
}

model Vlog {
  id         Int      @id @default(autoincrement())
  titleTh    String   @map("title_th")
  titleEn    String?  @map("title_en")
  titleCn    String?  @map("title_cn")
  viewCount  Int      @default(0) @map("view_count")
  order      Int      @default(1) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  youtubeId  String?  @map("youtube_id")
  youtubeUrl String?  @map("youtube_url")

  @@map("vlogs")
}

model Page {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  titleTh    String?  @map("title_th")
  titleEn    String?  @map("title_en")
  titleCn    String?  @map("title_cn")
  contentTh  String?  @map("content_th")
  contentEn  String?  @map("content_en")
  contentCn  String?  @map("content_cn")
  updatedAt  DateTime @updatedAt @map("updated_at")
  image      String?
  nameCn     String?  @map("name_cn")
  nameEn     String?  @map("name_en")
  nameTh     String?  @map("name_th")
  positionCn String?  @map("position_cn")
  positionEn String?  @map("position_en")
  positionTh String?  @map("position_th")

  @@map("pages")
}

enum UserStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

enum UserRole {
  admin
  approver
  author

  @@map("user_role")
}

enum ArticleStatus {
  draft
  approved
  rejected
  pending

  @@map("article_status")
}

enum AuthorType {
  user
  penname

  @@map("article_type")
}

enum ClipType {
  upload
  youtube

  @@map("clip_type")
}
