generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int        @id @default(autoincrement()) @map("id")
  name             String     @map("name")
  image            String?    @map("image")
  email            String     @unique @map("email")
  password         String     @map("password")
  role             UserRole   @default(author) @map("role")
  position         String?    @map("position")
  status           UserStatus @default(active) @map("status")
  createdAt        DateTime   @default(now()) @map("created_at")
  approvedArticles Article[]  @relation("ArticleApprover")
  articles         Article[]  @relation("ArticleAuthor")

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement()) @map("id")
  name     String    @map("name")
  slug     String    @unique @map("slug")
  nameCn   String?   @map("name_cn")
  nameEn   String?   @map("name_en")
  articles Article[]

  @@map("categories")
}

model Article {
  id           Int           @id @default(autoincrement()) @map("id")
  categoryId   Int           @map("category_id")
  authorId     Int?          @map("author_id")
  title        String        @map("title")
  slug         String        @unique @map("slug")
  excerpt      String?
  content      String
  thumbnail    String?
  status       ArticleStatus @default(draft)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  authorType   AuthorType    @default(user) @map("author_type")
  penName      String?       @map("pen_name")
  rejectReason String?       @map("reject_reason")
  approvedAt   DateTime?     @map("approved_at")
  approvedById Int?          @map("approved_by_id")
  keywords     String?
  viewCount    Int           @default(0) @map("view_count")
  position     String?       @map("position")
  shareCount   Int           @default(0) @map("share_count")
  tags         ArticleTag[]
  approvedBy   User?         @relation("ArticleApprover", fields: [approvedById], references: [id])
  author       User?         @relation("ArticleAuthor", fields: [authorId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("articles")
}

model Tag {
  id       Int          @id @default(autoincrement()) @map("id")
  name     String       @unique @map("name")
  articles ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId Int     @map("article_id")
  tagId     Int     @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Comment {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name")
  email     String?  @map("email")
  message   String   @map("message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model SiteSetting {
  id          Int          @id @default(1)
  name        String
  logo        String?
  address     String?
  phone       String?
  email       String?
  footerText  String?      @map("footer_text")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  socialLinks SocialLink[]

  @@map("site_settings")
}

model SocialLink {
  id        Int         @id @default(autoincrement())
  platform  String
  url       String
  icon      String?
  order     Int         @default(0)
  siteId    Int         @default(1) @map("site_id")
  createdAt DateTime    @default(now()) @map("created_at")
  site      SiteSetting @relation(fields: [siteId], references: [id])

  @@map("social_links")
}

model ShortClip {
  id           Int      @id @default(autoincrement())
  titleTh      String   @map("title_th")
  titleEn      String   @map("title_en")
  titleCn      String   @map("title_cn")
  videoUrl     String?  @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  youtubeUrl   String?  @map("youtube_url")
  youtubeId    String?  @map("youtube_id")
  viewCount    Int      @default(0) @map("view_count")
  order        Int      @default(1) @map("order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("short_clips")
}

model SsruAround {
  id        Int      @id @default(autoincrement())
  titleTh   String   @map("title_th")
  titleEn   String?  @map("title_en")
  titleCn   String?  @map("title_cn")
  title     String?  @map("title") // Keep for compatibility
  issue     String?  @map("issue")
  year      String?  @map("year")
  imageTh   String?  @map("image_th")
  imageEn   String?  @map("image_en")
  imageCn   String?  @map("image_cn")
  image     String?  @map("image") // Keep for compatibility
  link      String?  @map("link")
  type      String?  @map("type")
  order     Int      @default(1) @map("order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ssru_around")
}

enum UserStatus {
  active
  inactive
  suspended
  
  @@map("user_status")
}

enum UserRole {
  admin
  approver
  author

  @@map("user_role")
}

enum ArticleStatus {
  draft
  approved
  rejected
  pending

  @@map("article_status")
}

enum AuthorType {
  user
  penname

  @@map("article_type")
}

enum ClipType {
  upload
  youtube

  @@map("clip_type")
}
